# Development files
^.*\.Rproj$
^\.Rproj\.user$
^README\.Rmd$
^README\.html$

# Git and GitHub
^\.git$
^\.gitignore$
^\.gitattributes$
^\.github$

# Documentation
^docs$

# Development directories
^data-raw$
^inst/hooks/claude-check\.sh$
^scripts-paper$

# Testing
^tests/testthat/_snaps$
^tests/testthat/Rplots\.pdf$
^Rplots\.pdf$

# macOS
^\.DS_Store$
\.DS_Store$

# Windows
^Thumbs\.db$

# Temporary files
^.*\.log$
^.*\.tmp$
^.*\.temp$
^.*\.bak$
^.*\.swp$
^.*\.swo$
~$

# Package development
^CRAN-RELEASE$
^CRAN-SUBMISSION$
^\.Rlib$
^\.Rcheck$
^\.\.Rcheck$
^hetid\.Rcheck$
^.*\.tar\.gz$
^\.Rhistory$
^\.worktrees$
^\.claude$
^\.agents$
^\.superpowers$
^CLAUDE\.md$
^CLAUDE\.local\.md$
^AGENTS\.md$

# Other common files to exclude
^\.lintr$
^\.pre-commit-config\.yaml$
^\.vscode$
^\.idea$

^LICENSE\.md$

^man-roxygen$
