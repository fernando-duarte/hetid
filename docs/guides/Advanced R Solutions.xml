# contribs_first_edition_json <- gh::gh("/repos/:owner/:repo/contributors",
#   owner = "Tazinho",
#   repo = "Advanced-R-Solutions-Ed1",
#   .limit = Inf
# )
# contribs_first_edition <- tibble(
#   login = contribs_first_edition_json %>% map_chr("login"),
